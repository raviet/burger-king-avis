rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /config/{doc} {
      allow read:  if true;
      allow write: if request.auth != null;
    }
    match /config-dev/{doc} {
      allow read:  if true;
      allow write: if request.auth != null;
    }
    match /cooldowns/{clientId} {
      allow create, update: if request.resource.data.lastSubmit == request.time;
      allow read:           if request.auth != null;
    }
    match /cooldowns-dev/{clientId} {
      allow create, update: if request.resource.data.lastSubmit == request.time;
      allow read:           if request.auth != null;
    }
    match /avis/{doc} {
      allow create: if request.resource.data.clientId is string
                    && request.resource.data.stars   is int
                    && request.resource.data.stars   >= 1
                    && request.resource.data.stars   <= 4
                    && request.resource.data.message is string
                    && request.resource.data.message.size() >= 1
                    && request.resource.data.message.size() <= 2000
                    && (
                      !exists(/databases/$(database)/documents/cooldowns/$(request.resource.data.clientId))
                      || get(/databases/$(database)/documents/cooldowns/$(request.resource.data.clientId)).data.lastSubmit < request.time - duration.value(1, 'd')
                    );
      allow update: if request.auth != null;
      allow read:   if request.auth != null;
      allow delete: if false;
    }
    match /avis-dev/{doc} {
      allow create: if request.resource.data.clientId is string
                    && request.resource.data.stars   is int
                    && request.resource.data.stars   >= 1
                    && request.resource.data.stars   <= 4
                    && request.resource.data.message is string
                    && request.resource.data.message.size() >= 1
                    && request.resource.data.message.size() <= 2000
                    && (
                      !exists(/databases/$(database)/documents/cooldowns-dev/$(request.resource.data.clientId))
                      || get(/databases/$(database)/documents/cooldowns-dev/$(request.resource.data.clientId)).data.lastSubmit < request.time - duration.value(1, 'd')
                    );
      allow update: if request.auth != null;
      allow read:   if request.auth != null;
      allow delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
